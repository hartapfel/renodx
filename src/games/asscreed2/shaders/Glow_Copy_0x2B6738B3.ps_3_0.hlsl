float Alpha_44 : register(c132);
float4 ColorMultiply_21 : register(c130);
sampler2D DiffuseMap_3 : register(s3);
sampler2D DiffuseMultiply_4 : register(s4);
float4 MaskVertexR_14 : register(c129);
sampler2D NormalMap_2 : register(s2);
sampler2D SkinShader_1 : register(s1);
sampler2D SkinshaderTile_0;
float SpaceTransparency_39 : register(c131);
float TileScale_4 : register(c128);
float4 g_AmbientCube[6] : register(c24);
float4 g_FogColor : register(c16);
float4 g_FogParams : register(c17);
float4 g_NormalScale : register(c94);
sampler2D g_WorldLightMapSampler : register(s12);
float4 g_WorldLightmapParameters : register(c87);
float4 g_WorldLightmapUVParameters : register(c88);
float4 g_WorldLightmapZOffsetParameters : register(c89);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 color : COLOR;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float vface : VFACE;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color1 : COLOR1;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0 = i.texcoord2.w;
	clip(r0);
	r0.xy = TileScale_4.xx * i.texcoord.xy;
	r0 = tex2D(SkinshaderTile_0, r0.xy);
	r0.x = r0.w * r0.x;
	r0.xy = r0.xy + float2(-0.5, -0.5);
	r0.xy = r0.xy + r0.xy;
	r0.w = dot(r0.xy, -r0.xy) + 1;
	r0.w = 1 / sqrt(r0.w);
	r0.z = 1 / r0.w;
	r1 = tex2D(SkinShader_1, i.texcoord.xy);
	r2.xyz = lerp(float3(0, 0, 1), r0.xyz, r1.zzz);
	r0 = tex2D(NormalMap_2, i.texcoord.xy);
	r0.x = r0.w * r0.x;
	r0.xy = r0.xy + float2(-0.5, -0.5);
	r0.xy = r0.xy + r0.xy;
	r0.w = dot(r0.xy, -r0.xy) + 1;
	r0.w = 1 / sqrt(r0.w);
	r0.z = 1 / r0.w;
	r0.xyz = r0.xyz + r2.xyz;
	r0.xyz = r0.xyz * float3(1, 1, 0.7);
	r1.xyz = normalize(r0.xyz);
	r0.xyz = normalize(i.texcoord4.xyz);
	r0.xyz = r0.xyz * r1.yyy;
	r2.xyz = normalize(i.texcoord3.xyz);
	r0.xyz = r1.xxx * r2.xyz + r0.xyz;
	r2.xyz = normalize(i.texcoord5.xyz);
	r0.xyz = r1.zzz * r2.xyz + r0.xyz;
	r1.xyz = normalize(r0.xyz);
	r0.xyz = r1.xyz * -g_NormalScale.xxx;
	r0.w = (i.vface >= 0) ? 1 : -1;
	r0.xyz = (-r0.www >= 0) ? r1.xyz : r0.xyz;
	r1.xy = r0.xy * g_WorldLightmapParameters.xx + i.texcoord2.xy;
	r2.xz = float2(1, -0.5);
	r1.xy = r1.xy * g_WorldLightmapUVParameters.zw + -r2.zz;
	r0.w = 1 / g_WorldLightmapZOffsetParameters.y;
	r2.y = dot(i.texcoord6.xyz, i.texcoord6.xyz);
	r2.y = 1 / sqrt(r2.y);
	r2.z = 1 / r2.y;
	r3.xyz = r2.yyy * i.texcoord6.xyz;
	r2.y = saturate(dot(r3.xyz, r0.xyz));
	r3.xyz = normalize(r0.xyz);
	r0.x = r2.z + -g_WorldLightmapZOffsetParameters.x;
	r0.y = r2.z + -g_FogParams.x;
	r0.y = saturate(r0.y * g_FogParams.y);
	r0.y = r0.y * g_FogParams.z;
	r1.w = saturate(r0.w * r0.x);
	r1.z = 0;
	r1 = tex2Dlod(g_WorldLightMapSampler, r1);
	r0.x = r1.w * g_WorldLightmapParameters.w + g_WorldLightmapParameters.y;
	r1.xyz = r1.xyz * g_WorldLightmapUVParameters.xxx;
	r0.x = r0.x + -i.texcoord2.z;
	r0.x = saturate(abs(r0.x) * -g_WorldLightmapParameters.z + r2.x);
	r0.xzw = r0.xxx * r1.xyz;
	r1.xyz = (r3.xyz >= 0) ? float3(1, 1, 1) : float3(0, 0, 0);
	r2.xzw = (-r3.xyz >= 0) ? float3(1, 1, 1) : float3(0, 0, 0);
	r3.xyz = r3.xyz * r3.xyz;
	r4 = r3.x * g_AmbientCube[1];
	r4 = r2.x * r4;
	r5 = r3.x * g_AmbientCube[0];
	r4 = r5 * r1.x + r4;
	r5 = r3.y * g_AmbientCube[2];
	r4 = r5 * r1.y + r4;
	r5 = r3.y * g_AmbientCube[3];
	r4 = r5 * r2.z + r4;
	r5 = r3.z * g_AmbientCube[4];
	r3 = r3.z * g_AmbientCube[5];
	r1 = r5 * r1.z + r4;
	r1 = r3 * r2.w + r1;
	r1.xyz = r1.www * r1.xyz;
	r1.w = r2.y * 0.19999999;
	r1.xyz = r1.xyz * r1.www;
	r3 = tex2D(DiffuseMultiply_4, i.texcoord.xy);
	r3.xyz = saturate(r3.xyz);
	r4 = tex2D(DiffuseMap_3, i.texcoord.xy);
	r2.xzw = r3.xyz * r4.xyz;
	r1.w = r4.w * i.color.w;
	r3.xyz = r2.xzw * MaskVertexR_14.xyz;
	r3.xyz = r3.xyz * float3(2, 2, 2) + -r2.xzw;
	r2.xzw = i.color.xxx * r3.xyz + r2.xzw;
	r3.xyz = r2.xzw * ColorMultiply_21.xyz;
	r3.xyz = r3.xyz * i.texcoord1.xxx;
	r1.xyz = r1.xyz * r3.xyz;
	r4.xyz = r0.xzw * r3.xyz + -r1.xyz;
	r0.xzw = r0.xzw * r3.xyz;
	r0.x = saturate(dot(r0.xzw, g_WorldLightmapUVParameters.yyy));
	r0.xzw = r0.xxx * r4.xyz + r1.xyz;
	r1.x = r2.y * r2.y;
	r1.y = pow(r2.y, 0.29999998);
	r1.y = r1.y * r1.w;
	r1.y = r1.y * 0.79999995;
	r1.x = r1.x * 16;
	r1.z = frac(r1.x);
	r1.x = -r1.z + r1.x;
	r1.x = r1.x * 0.0625;
	r1.xzw = r1.xxx * r2.xzw;
	r1.xzw = r1.xzw * float3(-0.24, 0.08, 0.39999998);
	r1.xzw = r2.xzw * float3(0.64, 0.32, 0) + r1.xzw;
	r0.xzw = r1.xzw * ColorMultiply_21.xyz + r0.xzw;
	r1.xzw = -r0.xzw + g_FogColor.xyz;
	o.color.xyz = r0.yyy * r1.xzw + r0.xzw;
	r0.x = 1 / i.texcoord1.w;
	o.color1.xyz = r0.xxx * i.texcoord1.zzz;
	r0.x = i.texcoord2.z * 111.408455 + 0.5;
	r0.x = frac(r0.x);
	r0.x = r0.x * 6.283185 + -3.1415925;
	r2.y = sin(r0.x);
	r0.x = r2.y * SpaceTransparency_39.x;
	r0.y = frac(r0.x);
	r0.x = saturate(-r0.y + r0.x);
	r0.x = (-r0.x >= 0) ? 12 : r1.y;
	r0.x = r0.x * Alpha_44.x;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color.xyz = 1.f.xxx - exp2(-max(o.color.xyz, 0.f.xxx));
	o.color.w = saturate(o.color.w);
	o.color1.xyz = max(o.color1.xyz, 0.f.xxx);
	o.color1.w = saturate(o.color1.w);

	return o;
}
