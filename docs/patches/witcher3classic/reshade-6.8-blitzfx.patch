--- a/source/d3d11/d3d11.cpp
+++ b/source/d3d11/d3d11.cpp
@@ -10,6 +10,7 @@
 #include "dll_log.hpp" // Include late to get 'hr_to_string' helper function
 #include "hook_manager.hpp"
 #include "addon_manager.hpp"
+#include "ini_file.hpp"
 
 extern thread_local bool g_in_dxgi_runtime;
 
@@ -80,6 +81,9 @@ extern "C" HRESULT WINAPI D3D11CreateDeviceAndSwapChain(IDXGIAdapter *pAdapter,
 
 	// Use local feature level variable in case the application did not pass one in
 	D3D_FEATURE_LEVEL feature_level = D3D_FEATURE_LEVEL_11_0;
+	const bool force_multithread_protection = reshade::global_config().get("DX11", "ForceMultithreadProtection");
+	if (force_multithread_protection)
+		Flags &= ~D3D11_CREATE_DEVICE_SINGLETHREADED;
 
 	g_in_dxgi_runtime = true;
 	HRESULT hr = trampoline(pAdapter, DriverType, Software, Flags, pFeatureLevels, FeatureLevels, SDKVersion, nullptr, nullptr, ppDevice, &feature_level, nullptr);
@@ -115,6 +119,17 @@ extern "C" HRESULT WINAPI D3D11CreateDeviceAndSwapChain(IDXGIAdapter *pAdapter,
 	reshade::log::message(reshade::log::level::info, "Using feature level %x.", feature_level);
 
 	auto device = *ppDevice;
+	if (force_multithread_protection)
+	{
+		com_ptr<ID3D11DeviceContext> immediate_context;
+		device->GetImmediateContext(&immediate_context);
+		com_ptr<ID3D11Multithread> multithread;
+		if (SUCCEEDED(immediate_context->QueryInterface(&multithread)))
+		{
+			multithread->SetMultithreadProtected(TRUE);
+			reshade::log::message(reshade::log::level::info, "Enabled persistent D3D11 multithread protection for injector compatibility.");
+		}
+	}
 	// Query for the DXGI device and immediate device context since we need to reference them in the proxy device
 	com_ptr<IDXGIDevice1> dxgi_device;
 	hr = device->QueryInterface(&dxgi_device);
@@ -178,7 +193,51 @@ extern "C" HRESULT WINAPI D3D11CreateDeviceAndSwapChain(IDXGIAdapter *pAdapter,
 
 		reshade::log::message(reshade::log::level::info, "Calling IDXGIFactory::CreateSwapChain:");
 
+		DXGI_SWAP_CHAIN_DESC discovery_desc;
+		HWND discovery_window = nullptr;
+		// BlitzFX 1.1.0 borrows GetForegroundWindow for DXGI hook discovery.
+		// A foreign/inaccessible foreground window can reject the swapchain.
+		// Its fallback then hooks hardcoded offsets in this ReShade DLL instead
+		// of DXGI, disconnecting Present (settings/history) and ResizeBuffers.
+		// Give only that audited discovery call an owned, hidden window.
+		void *frames[16];
+		const USHORT frame_count = CaptureStackBackTrace(0, ARRAYSIZE(frames), frames, nullptr);
+		for (const auto name : { L"blitz-fx.asi", L"d3d11.dll" })
+		{
+			const auto image = reinterpret_cast<const uint8_t *>(GetModuleHandleW(name));
+			if (image == nullptr)
+				continue;
+			const auto dos = reinterpret_cast<const IMAGE_DOS_HEADER *>(image);
+			if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew < 0 || dos->e_lfanew > 4096)
+				continue;
+			const auto nt = reinterpret_cast<const IMAGE_NT_HEADERS64 *>(image + dos->e_lfanew);
+			if (nt->Signature != IMAGE_NT_SIGNATURE || nt->FileHeader.Machine != IMAGE_FILE_MACHINE_AMD64 ||
+				nt->FileHeader.TimeDateStamp != 0x67410424 || nt->OptionalHeader.SizeOfImage != 0x9e000)
+				continue;
+			for (USHORT index = 0; index < frame_count; ++index)
+			{
+				const auto address = reinterpret_cast<uintptr_t>(frames[index]);
+				if (address < reinterpret_cast<uintptr_t>(image) + 0x5e30 || address >= reinterpret_cast<uintptr_t>(image) + 0x7070)
+					continue;
+				discovery_window = CreateWindowExW(0, L"STATIC", L"BlitzFX DXGI hook discovery", WS_OVERLAPPED,
+					0, 0, pSwapChainDesc->BufferDesc.Width, pSwapChainDesc->BufferDesc.Height,
+					nullptr, nullptr, GetModuleHandleW(nullptr), nullptr);
+				if (discovery_window != nullptr)
+				{
+					discovery_desc = *pSwapChainDesc;
+					discovery_desc.OutputWindow = discovery_window;
+					pSwapChainDesc = &discovery_desc;
+					reshade::log::message(reshade::log::level::info, "Using an owned hidden window for BlitzFX DXGI hook discovery.");
+				}
+				break;
+			}
+			break;
+		}
+
 		hr = factory->CreateSwapChain(device, const_cast<DXGI_SWAP_CHAIN_DESC *>(pSwapChainDesc), ppSwapChain);
+		// This swapchain is used only to read its vtable, never to present.
+		if (discovery_window != nullptr)
+			DestroyWindow(discovery_window);
 	}
 
